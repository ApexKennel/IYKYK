rules_version = '2';
service cloud.firestore {
  match /databases/{database} /documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Messages Validation
    function isValidMessage(data) {
      return data.text is string && data.text.size() <= 1000 &&
             data.senderId is string && data.senderId == request.auth.uid &&
             data.timestamp == request.time &&
             (!('flag' in data) || data.flag is string) &&
             (!('flagDesc' in data) || data.flagDesc is string) &&
             (!('isAI' in data) || data.isAI is bool);
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && resource.data.senderId == request.auth.uid;
      allow create: if isSignedIn() && isValidMessage(incoming());
      // No updates for now to keep it immutable, or restrict to AI status
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
      
      match /contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
